[Unit]
Description=obsync daemon – Obsidian vault sync service
Documentation=https://github.com/tetsureign/obsync
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/obsyncd
WorkingDirectory=%h/.local/share/obsync

# Runtime configuration
# The database path is resolved internally to the platform data dir
# (~/.local/share/obsync/obsync.db on Linux), matching WorkingDirectory below.
# DB_FILE_NAME remains available as an optional override.
Environment=NODE_ENV=production
Environment=PORT=7274

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Lightweight security hardening
# PrivateUsers/ProtectHome omitted — daemon needs access to vault dirs under ~/
# and ~/.ssh/ for Git SSH remotes (see SECURITY.md)
# PrivateNetwork omitted — daemon needs outbound network for git push/pull
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
